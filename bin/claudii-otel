#!/bin/bash
# claudii-otel — fold Claude Code's local OTLP/JSON export into the perf cache.
#
# The OTEL path is optional and local-only. bin/claudii-otel-receiver writes the
# raw OTLP batches Claude Code emits to $CACHE/otel/raw/ (one file per signal
# and UTC day), and
# `claudii-otel build` folds them into the SAME .latency shape lib/cmd/perf.sh
# already renders from transcripts — plus the exact fields the transcript
# estimate can't provide (duration_ms, ttft_ms, api_error status codes). The
# only claudii<->OTEL coupling is the local JSONL file; nothing here touches the
# network.
#
# Optional fan-out (perf.otel.forward): the receiver tees each batch verbatim to
# an internal collector gateway. claudii itself never reads the gateway — it
# only reads the local file; the forward is purely for central retention.
#
# Usage:
#   claudii-otel build [--days N]   # emit {source,latency,errors} JSON on stdout
#   claudii-otel compact            # fold closed days into rows/ and gzip them
#   claudii-otel migrate            # one-time: old single-file layout → day files
#   claudii-otel receiver [args]    # exec the local OTLP receiver (foreground)
#   claudii-otel doctor             # check receiver wiring + data freshness
#   claudii-otel cache-dir          # print the OTEL data directory

set -uo pipefail
export CLAUDII_HOME="${CLAUDII_HOME:-$(cd "$(dirname "$0")/.." && pwd)}"
command -v jq >/dev/null 2>&1 || { printf 'claudii-otel: jq not found — install jq\n' >&2; exit 1; }

CACHE_BASE="${CLAUDII_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/claudii}"
OTEL_DIR="$CACHE_BASE/otel"
INSIGHTS_DIR="$CACHE_BASE/insights"
RAW_DIR="$OTEL_DIR/raw"
ROWS_DIR="$OTEL_DIR/rows"
JQ_PROGRAM="$CLAUDII_HOME/lib/otel.jq"
EXTRACT_PROGRAM="$CLAUDII_HOME/lib/otel-extract.jq"
RECEIVER="$CLAUDII_HOME/bin/claudii-otel-receiver"

_mtime() { stat -f%m "$1" 2>/dev/null || stat -c%Y "$1" 2>/dev/null || echo 0; }

# shellcheck source=lib/insights_stream.sh
source "$CLAUDII_HOME/lib/insights_stream.sh"

# floor = today - (days-1) in UTC; BSD date first, GNU fallback (matches perf).
# window-cutoff probe — keep in sync with _window_cutoffs (lib/timefmt.sh)
_floor_day() {
  local days="$1"
  date -u -v-"$(( days - 1 ))"d +%Y-%m-%d 2>/dev/null \
    || date -u -d "$(( days - 1 )) days ago" +%Y-%m-%d 2>/dev/null \
    || printf ''
}

# {sessionId: repo} from the insights caches — OTEL events carry session.id but
# no cwd, so the repo is resolved here (same source perf's transcript path uses).
# Arg: days — an event in the window belongs to a session whose last_seen is in
# the window too, so the map only needs those caches (lib/insights_stream.sh).
# Emits exactly one JSON object: `{}` replaces a failed run instead of being
# appended to whatever jq had already printed.
_repomap() {
  local days="${1:-}" map
  map=$(_insights_stream "$INSIGHTS_DIR" "$days" \
    | jq -cn 'reduce inputs as $s ({};
           if ($s.sessionId // null) != null and ($s.project.repo // "") != ""
           then .[$s.sessionId] = $s.project.repo else . end)' 2>/dev/null) || map=""
  printf '%s' "${map:-"{}"}"
}

# Storage layout under $OTEL_DIR (the receiver writes raw/, everything else is
# derived here):
#   raw/<signal>-YYYY-MM-DD[.<tag>].jsonl      open (today's) or not yet gzipped
#   raw/<signal>-YYYY-MM-DD[.<tag>].jsonl.gz   closed days — the lossless history
#   rows/YYYY-MM-DD.v<N>.ndjson                samples of a closed day, extracted
#                                              from its .gz files (otel-extract.jq)
#   traces.jsonl / logs.jsonl                  pre-day-file layout, until `migrate`
# build reads rows + raw of its window only, so its cost follows the window,
# not the history (one 4 GB file made every `perf` parse all of it, 82 s).
#
# Two rules keep the history safe and every sample counted once:
#   - raw data only ever moves INTO a .gz (plain → .gz → plain removed); no
#     code path deletes a raw file whose content is not in a .gz already;
#   - rows are derived from the .gz files alone, so a plain file that is still
#     around (open day, quiet guard, failed gzip) is never also in rows.
#
# Bump when lib/otel-extract.jq's row shape or extraction changes: rows files of
# another version are ignored, and compact rebuilds them from the gzipped days.
OTEL_ROWS_VERSION=1
# A request that straddles UTC midnight can still append to yesterday's file;
# compact leaves a raw file of yesterday alone until it has been quiet this long.
COMPACT_QUIET_SECS=600
# compact and migrate never run concurrently (a half-split day must not be
# gzipped); build skips compaction while the lock is held.
LOCK_DIR="$OTEL_DIR/.lock"
STAGE_DIR="$OTEL_DIR/.migrate"

_DAY_RE='([0-9]{4}-[0-9]{2}-[0-9]{2})'
# Sets _DAY to the YYYY-MM-DD in a file name ("" if none) — no subshell, it
# runs once per file.
_file_day() {
  _DAY=""
  if [[ "${1##*/}" =~ $_DAY_RE ]]; then _DAY="${BASH_REMATCH[1]}"; fi
}

# 0 = acquired. A lock whose holder is gone (killed perf, crash) is taken over;
# a lock without a pid file yet is only taken over once it is a minute old.
_otel_lock() {
  mkdir -p "$OTEL_DIR" 2>/dev/null
  if mkdir "$LOCK_DIR" 2>/dev/null; then
    printf '%s\n' "$$" > "$LOCK_DIR/pid"; return 0
  fi
  local pid; pid=$(cat "$LOCK_DIR/pid" 2>/dev/null)
  if [[ -n "$pid" ]]; then
    kill -0 "$pid" 2>/dev/null && return 1
  elif (( $(date +%s) - $(_mtime "$LOCK_DIR") < 60 )); then
    return 1
  fi
  rm -rf "$LOCK_DIR"
  mkdir "$LOCK_DIR" 2>/dev/null || return 1
  printf '%s\n' "$$" > "$LOCK_DIR/pid"
}
_otel_unlock() { rm -rf "$LOCK_DIR"; }

_cmd_compact() {
  _otel_lock || { printf 'compact: another compact/migrate is running\n' >&2; return 1; }
  _compact_locked; local rc=$?
  _otel_unlock
  return "$rc"
}

# Gzip every closed day's plain raw files, then (re)build its rows from the gz
# files when rows are missing or older than one of them. Caller holds the lock.
_compact_locked() {
  [[ -d "$RAW_DIR" ]] || return 0
  mkdir -p "$ROWS_DIR" || return 1
  local today yesterday now
  today=$(date -u +%Y-%m-%d)
  yesterday=$(_floor_day 2)
  now=$(date +%s)
  local f nf day days=" " rows tmp old stale busy rc=0
  local -a plain gz
  shopt -s nullglob
  # Leftovers of an interrupted run — the lock rules out a live one.
  rm -f "$ROWS_DIR"/*.ndjson.?????? "$RAW_DIR"/*.gz.tmp
  for f in "$RAW_DIR"/*.jsonl "$RAW_DIR"/*.jsonl.gz; do
    _file_day "$f"; day="$_DAY"
    [[ -n "$day" && "$day" < "$today" ]] || continue
    [[ "$days" == *" $day "* ]] || days+="$day "
  done
  for day in $days; do
    plain=("$RAW_DIR"/*-"$day"*.jsonl)
    busy=0
    if [[ "$day" == "$yesterday" ]]; then
      for f in ${plain[@]+"${plain[@]}"}; do
        [[ "${f##*/}" == *-"$day".jsonl ]] || continue   # only the receiver's own file
        (( now - $(_mtime "$f") < COMPACT_QUIET_SECS )) && busy=1
      done
    fi
    (( busy )) && continue
    for f in ${plain[@]+"${plain[@]}"}; do
      if [[ -e "$f.gz" ]]; then
        # An interrupted run: the gzip landed, the rm did not.
        if gzip -dc "$f.gz" 2>/dev/null | cmp -s - "$f"; then rm -f "$f"; continue; fi
        # Different data under a taken name: keep both, the new one renamed
        # to a name that is free as plain AND as .gz (never overwrite raw data).
        local n=0
        nf="${f%.jsonl}.$now.jsonl"
        while [[ -e "$nf" || -e "$nf.gz" ]]; do
          nf="${f%.jsonl}.$now-$(( ++n )).jsonl"
        done
        mv "$f" "$nf" || { rc=1; continue; }
        f="$nf"
      fi
      if gzip -c "$f" > "$f.gz.tmp" && mv -f "$f.gz.tmp" "$f.gz"; then
        rm -f "$f"
      else
        rm -f "$f.gz.tmp"; rc=1
      fi
    done
    gz=("$RAW_DIR"/*-"$day"*.jsonl.gz)
    (( ${#gz[@]} )) || continue
    rows="$ROWS_DIR/$day.v$OTEL_ROWS_VERSION.ndjson"
    stale=0
    [[ -f "$rows" ]] || stale=1
    for f in "${gz[@]}"; do [[ "$f" -nt "$rows" ]] && stale=1; done
    (( stale )) || continue
    tmp=$(mktemp "$rows.XXXXXX") || { rc=1; continue; }
    # A .gz that does not decode fails the whole day: no rows from a prefix.
    if ( for f in "${gz[@]}"; do gzip -dc "$f" || exit 1; done ) \
         | jq -cnR -f "$EXTRACT_PROGRAM" > "$tmp"; then
      mv -f "$tmp" "$rows"
      for old in "$ROWS_DIR/$day".v*.ndjson; do
        [[ "$old" == "$rows" ]] || rm -f "$old"
      done
    else
      rm -f "$tmp"; rc=1
    fi
  done
  shopt -u nullglob
  return "$rc"
}

_cmd_build() {
  local days=30
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --days) shift; days="${1:-30}" ;;
      *) printf 'build: unknown option: %s\n' "$1" >&2; exit 1 ;;
    esac
    shift
  done
  if ! [[ "$days" =~ ^[0-9]+$ ]] || [[ "$days" -lt 1 ]]; then
    printf 'build: --days must be a positive integer (got: %s)\n' "$days" >&2; exit 1
  fi

  # Compaction is an optimisation for later runs: while a migrate holds the
  # lock it is skipped, and build reads whatever is there.
  if _otel_lock; then _compact_locked; _otel_unlock; fi

  # Files are picked by the day in their name. A rows/raw file is named after
  # the day a batch ARRIVED; a span that started before midnight arrives after
  # it, so files from one day before the floor are read too and the per-row
  # .day filter in lib/otel.jq does the exact cut.
  local floor from
  floor=$(_floor_day "$days")
  from=$(_floor_day "$(( days + 1 ))")
  local rows=() fresh=() legacy=() f
  shopt -s nullglob
  for f in "$ROWS_DIR"/*.v"$OTEL_ROWS_VERSION".ndjson; do
    _file_day "$f"; [[ -n "$_DAY" && ! "$_DAY" < "$from" ]] && rows+=("$f")
  done
  for f in "$RAW_DIR"/*.jsonl; do
    _file_day "$f"; [[ -n "$_DAY" && ! "$_DAY" < "$from" ]] && fresh+=("$f")
  done
  shopt -u nullglob
  for f in "$OTEL_DIR/traces.jsonl" "$OTEL_DIR/logs.jsonl"; do
    [[ -s "$f" ]] && legacy+=("$f")
  done
  # An interrupted migrate leaves its source renamed. Until the run is verified
  # none of its parts are in raw/, so it is read like the legacy file it was.
  # (A verified run's parts are moving into raw/; doctor flags the rest.)
  shopt -s nullglob
  for f in "$OTEL_DIR"/traces.jsonl.migrating-* "$OTEL_DIR"/logs.jsonl.migrating-*; do
    local _sig="${f##*/}"; _sig="${_sig%%.*}"
    [[ -e "$STAGE_DIR/$_sig-${f##*.migrating-}.verified" ]] || legacy+=("$f")
  done
  shopt -u nullglob
  if (( ${#rows[@]} + ${#fresh[@]} + ${#legacy[@]} == 0 )); then
    printf '{"source":"otel","latency":[],"errors":[]}\n'; return 0
  fi
  # Legacy files are still read (in full) until `migrate` ran; doctor says so.
  # No hint here: build's stdout is JSON and callers merge stderr into it.

  # The repo map goes to jq as a FILE, never as one --argjson argument: with
  # ~15k sessions it is ~0.8 MB — over Linux's 128 KiB per-argument cap already
  # and close to macOS's 1 MiB total.
  local mapfile; mapfile=$(mktemp "${TMPDIR:-/tmp}/claudii-otel-map.XXXXXX") || return 1
  _repomap "$days" > "$mapfile"
  # Raw lines go through otel-extract.jq with -R, so one half-written batch
  # (live-appended JSONL) skips itself via fromjson? instead of aborting.
  {
    if (( ${#rows[@]} )); then
      printf '%s\0' "${rows[@]}" | { xargs -0 cat 2>/dev/null || true; }
    fi
    if (( ${#fresh[@]} + ${#legacy[@]} )); then
      printf '%s\0' ${fresh[@]+"${fresh[@]}"} ${legacy[@]+"${legacy[@]}"} \
        | { xargs -0 cat 2>/dev/null || true; } \
        | jq -cnR -f "$EXTRACT_PROGRAM"
    fi
  } | jq -n --slurpfile repomap "$mapfile" --arg floor "$floor" -f "$JQ_PROGRAM"
  local rc=$?
  rm -f "$mapfile"
  return "$rc"
}

# One-time move from the single-file layout (traces.jsonl / logs.jsonl) to day
# files, built so that no step can lose a line:
#   1. rename <sig>.jsonl to <sig>.jsonl.migrating-<run> — an old receiver that
#      is still running starts a fresh <sig>.jsonl, the next migrate takes it;
#   2. split it into .migrate/ by each batch's own timestamp (otel_split.awk),
#      every part tagged legacy-<run> so it can never collide with another run;
#   3. check the parts hold every line read, mark the run verified;
#   4. move the parts into raw/, then remove the renamed source.
# An interrupted run resumes: unverified parts are split again, verified ones
# are moved. Nothing is deleted before its content sits in raw/.
_cmd_migrate() {
  _otel_lock || { printf 'migrate: another compact/migrate is running\n' >&2; return 1; }
  _migrate_locked; local rc=$?
  _otel_unlock
  return "$rc"
}

_migrate_locked() {
  local sig src run tag read_n part_n moved f found=0 rc=0
  local -a parts
  mkdir -p "$RAW_DIR" "$STAGE_DIR" || return 1
  shopt -s nullglob
  for sig in traces logs metrics other; do
    if [[ -s "$OTEL_DIR/$sig.jsonl" ]]; then
      mv "$OTEL_DIR/$sig.jsonl" "$OTEL_DIR/$sig.jsonl.migrating-$(date +%s)$$" || { rc=1; continue; }
      sleep 1   # let an append that was in flight during the rename land
    fi
    for src in "$OTEL_DIR/$sig.jsonl.migrating-"*; do
      found=1
      run="${src##*.migrating-}"
      tag="legacy-$run"
      if [[ ! -e "$STAGE_DIR/$sig-$run.verified" ]]; then
        rm -f "$STAGE_DIR/$sig"-*".$tag.jsonl"
        printf 'migrate: splitting %s (%d MB) by day…\n' "$src" "$(( $(wc -c < "$src") / 1048576 ))"
        read_n=$(LC_ALL=C awk -v tz_offset=0 -v dir="$STAGE_DIR" -v sig="$sig" -v tag="$tag" \
          -v fallback="$(date -u +%Y-%m-%d)" \
          -f "$CLAUDII_HOME/lib/epoch_to_date.awk" -f "$CLAUDII_HOME/lib/otel_split.awk" "$src") \
          || { rc=1; continue; }
        parts=("$STAGE_DIR/$sig"-*".$tag.jsonl")
        part_n=0
        if (( ${#parts[@]} )); then
          part_n=$(printf '%s\0' "${parts[@]}" | xargs -0 cat | wc -l | tr -d ' ')
        fi
        if [[ "$read_n" != "$part_n" ]]; then
          printf 'migrate: %s: read %s lines but the day files hold %s — keeping it\n' "$src" "$read_n" "$part_n" >&2
          rc=1; continue
        fi
        : > "$STAGE_DIR/$sig-$run.verified"
      fi
      parts=("$STAGE_DIR/$sig"-*".$tag.jsonl")
      moved=0
      for f in ${parts[@]+"${parts[@]}"}; do
        mv "$f" "$RAW_DIR/" && (( ++moved ))
      done
      if [[ -n "$(printf '%s\n' "$STAGE_DIR/$sig"-*".$tag.jsonl")" ]]; then
        printf 'migrate: could not move every part of %s — run migrate again\n' "$src" >&2
        rc=1; continue
      fi
      rm -f "$src" "$STAGE_DIR/$sig-$run.verified"
      printf 'migrate: %s → %d day file(s)\n' "$sig" "$moved"
    done
  done
  shopt -u nullglob
  if (( ! found )); then
    printf 'migrate: nothing to do — no single-file OTEL data in %s\n' "$OTEL_DIR"
    return "$rc"
  fi
  printf 'migrate: compacting closed days…\n'
  _compact_locked || { printf 'migrate: compact reported errors — run: claudii-otel compact\n' >&2; rc=1; }
  local sig2
  for sig2 in traces logs; do
    if [[ -e "$OTEL_DIR/$sig2.jsonl" ]]; then
      printf 'migrate: %s.jsonl is being written again — the receiver still runs the old code. Restart it (launchctl kickstart -k gui/%s/com.claudii.otel-receiver), then run migrate once more.\n' \
        "$sig2" "$(id -u)" >&2
      rc=1
    fi
  done
  (( rc )) || printf 'migrate: done\n'
  return "$rc"
}

_cmd_receiver() {
  [[ -f "$RECEIVER" ]] || { printf 'claudii-otel: receiver not found: %s\n' "$RECEIVER" >&2; exit 1; }
  command -v python3 >/dev/null 2>&1 || { printf 'claudii-otel: python3 required for the receiver\n' >&2; exit 1; }
  exec python3 "$RECEIVER" "$@"
}

_cmd_doctor() {
  printf 'claudii-otel doctor\n'
  if command -v python3 >/dev/null 2>&1; then
    printf '  python3      %s\n' "$(command -v python3)"
  else
    printf '  python3      MISSING — the receiver needs it\n'
  fi
  printf '  otel dir     %s\n' "$OTEL_DIR"
  # Counts come from file names and the compacted rows — doctor used to run a
  # full-history build (--days 36500) just to print one number.
  local now f mt newest=0 n=0
  now=$(date +%s)
  shopt -s nullglob
  local plain=("$RAW_DIR"/*.jsonl) gz=("$RAW_DIR"/*.jsonl.gz)
  local rows=("$ROWS_DIR"/*.v"$OTEL_ROWS_VERSION".ndjson)
  shopt -u nullglob
  for f in ${plain[@]+"${plain[@]}"}; do
    mt=$(_mtime "$f"); (( mt > newest )) && newest=$mt
  done
  if (( newest > 0 )); then
    printf '  raw          %d open day file(s) · last write %ds ago\n' "${#plain[@]}" "$(( now - newest ))"
  else
    printf '  raw          (no open day file — receiver not running, or no session yet)\n'
  fi
  if (( ${#gz[@]} )); then
    printf '  history      %d gzipped day file(s) · %s on disk\n' "${#gz[@]}" "$(du -sh "$OTEL_DIR" 2>/dev/null | cut -f1 | tr -d ' ')"
  fi
  if (( ${#rows[@]} )); then
    n=$(printf '%s\0' "${rows[@]}" | { xargs -0 cat 2>/dev/null || true; } | grep -c '"kind":"lat"')
  fi
  printf '  samples      %s response(s) in %d compacted day(s)\n' "$n" "${#rows[@]}"
  shopt -s nullglob
  for f in "$OTEL_DIR"/*.jsonl.migrating-*; do
    printf '  migrate      interrupted (%s) — run: claudii-otel migrate to finish it\n' "${f##*/}"
  done
  shopt -u nullglob
  for f in traces logs; do
    [[ -s "$OTEL_DIR/$f.jsonl" ]] || continue
    printf '  legacy       %s.jsonl (%d MB, read in full on every build) — run: claudii-otel migrate\n' \
      "$f" "$(( $(wc -c < "$OTEL_DIR/$f.jsonl") / 1048576 ))"
  done
  if [[ -r "$CACHE_BASE/otel.env" ]]; then
    printf '  env wiring   %s (telemetry exported to the receiver)\n' "$CACHE_BASE/otel.env"
  else
    printf '  env wiring   off — run: claudii-otel setup\n'
  fi
  local fwd; fwd=$("$CLAUDII_HOME/bin/claudii" config get perf.otel.forward 2>/dev/null)
  if [[ -n "$fwd" ]]; then
    printf '  forward      %s (batches mirrored to the gateway)\n' "$fwd"
  else
    printf '  forward      off (local-only; set perf.otel.forward to fan out)\n'
  fi
}

# Enable the OTEL path: flip the config flag, write the shell env file the plugin
# sources (fork-free), and generate a launchd plist for a persistent receiver.
# The plist is written to the cache (not auto-installed) — the user loads it, so
# nothing touches ~/Library/LaunchAgents without consent.
_cmd_setup() {
  local cli="$CLAUDII_HOME/bin/claudii"
  local endpoint beta forward
  endpoint=$("$cli" config get perf.otel.endpoint 2>/dev/null); [[ -z "$endpoint" ]] && endpoint="http://127.0.0.1:4318"
  beta=$("$cli" config get perf.otel.beta_traces 2>/dev/null)
  forward=$("$cli" config get perf.otel.forward 2>/dev/null)
  "$cli" config set perf.otel.enabled true >/dev/null 2>&1

  mkdir -p "$OTEL_DIR"
  local envf="$CACHE_BASE/otel.env"
  {
    printf '%s\n' '# generated by `claudii-otel setup` — sourced by the claudii plugin.'
    printf '%s\n' '# Points Claude Code telemetry at the local receiver. Undo: claudii-otel off.'
    printf '%s\n' 'export CLAUDE_CODE_ENABLE_TELEMETRY=1'
    printf '%s\n' 'export OTEL_LOGS_EXPORTER=otlp'
    printf '%s\n' 'export OTEL_TRACES_EXPORTER=otlp'
    printf '%s\n' 'export OTEL_METRICS_EXPORTER=none'
    printf '%s\n' 'export OTEL_EXPORTER_OTLP_PROTOCOL=http/json'
    printf 'export OTEL_EXPORTER_OTLP_ENDPOINT=%s\n' "$endpoint"
    [[ "$beta" == "true" ]] && printf '%s\n' 'export CLAUDE_CODE_ENHANCED_TELEMETRY_BETA=1'
    [[ -n "$forward" ]] && printf 'export CLAUDII_OTEL_FORWARD=%s\n' "$forward"
  } > "$envf"

  local py; py=$(command -v python3 || echo /usr/bin/python3)
  local py_dir; py_dir=$(dirname "$py")
  # Invoke the receiver script directly (arg0), not `python3 <script>`, so macOS
  # Login Items / "Allow in the Background" shows it as "claudii-otel-receiver"
  # instead of "python3". The env-shebang then needs Homebrew on PATH (launchd's
  # default PATH lacks it) — set in EnvironmentVariables below. Keep it +x.
  chmod +x "$RECEIVER" 2>/dev/null || true
  local plist="$OTEL_DIR/com.claudii.otel-receiver.plist"
  # The receiver process needs CLAUDII_OTEL_FORWARD too (it does the teeing), so
  # bake it into the plist env when configured.
  local fwd_xml=""
  [[ -n "$forward" ]] && printf -v fwd_xml '\n    <key>CLAUDII_OTEL_FORWARD</key><string>%s</string>' "$forward"
  cat > "$plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.claudii.otel-receiver</string>
  <key>ProgramArguments</key>
  <array>
    <string>$RECEIVER</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>$py_dir:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>CLAUDII_OTEL_DIR</key><string>$OTEL_DIR</string>$fwd_xml
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardErrorPath</key><string>$OTEL_DIR/receiver.log</string>
  <key>StandardOutPath</key><string>$OTEL_DIR/receiver.log</string>
</dict>
</plist>
PLIST

  printf 'claudii-otel: OTEL source enabled (perf.otel.enabled=true)\n'
  printf '  env written:   %s\n' "$envf"
  printf '  plist written: %s\n' "$plist"
  [[ -n "$forward" ]] && printf '  forwarding to: %s\n' "$forward"
  printf '\n'
  printf 'Next steps:\n'
  printf '  1. Start the receiver (persistent, restarts on boot):\n'
  printf '       cp "%s" ~/Library/LaunchAgents/\n' "$plist"
  printf '       launchctl load ~/Library/LaunchAgents/com.claudii.otel-receiver.plist\n'
  printf '  2. Reload your shell so the telemetry env is exported:  exec zsh\n'
  printf '  3. Run a Claude session, then:  claudii perf\n'
  printf '\nNo launchd? Run the receiver yourself:  claudii-otel receiver\n'
}

# Disable the OTEL path: flip the flag back and remove the shell env file. perf
# reverts to the transcript estimate. The launchd job is left for the user to
# unload (we never loaded it).
_cmd_off() {
  local cli="$CLAUDII_HOME/bin/claudii"
  "$cli" config set perf.otel.enabled false >/dev/null 2>&1
  rm -f "$CACHE_BASE/otel.env"
  printf 'claudii-otel: OTEL source disabled (perf reverts to the transcript estimate)\n'
  printf '  removed: %s\n' "$CACHE_BASE/otel.env"
  printf 'Stop the receiver:\n'
  printf '  launchctl unload ~/Library/LaunchAgents/com.claudii.otel-receiver.plist\n'
}

cmd="${1:-build}"; shift || true
case "$cmd" in
  build)     _cmd_build "$@" ;;
  compact)   _cmd_compact ;;
  migrate)   _cmd_migrate ;;
  receiver)  _cmd_receiver "$@" ;;
  setup)     _cmd_setup "$@" ;;
  off)       _cmd_off "$@" ;;
  doctor)    _cmd_doctor "$@" ;;
  cache-dir) printf '%s\n' "$OTEL_DIR" ;;
  -h|--help|help)
    cat <<'EOF'
claudii-otel — fold local OTLP/JSON telemetry into the perf cache

Usage:
  claudii-otel setup              enable the OTEL source (config + env + plist)
  claudii-otel off                disable it (perf reverts to transcript)
  claudii-otel build [--days N]   emit {source,latency,errors} JSON on stdout
  claudii-otel compact            fold closed days into rows/ and gzip their raw
                                  batches (build does this on its own)
  claudii-otel migrate            one-time: split the old single-file
                                  traces.jsonl/logs.jsonl into day files
  claudii-otel receiver [args]    exec the local OTLP receiver (foreground)
  claudii-otel doctor             check receiver wiring + data freshness
  claudii-otel cache-dir          print the OTEL data directory

Fan-out (optional): set perf.otel.forward to an internal collector URL and the
receiver mirrors every batch there (best-effort) for central retention.
EOF
    ;;
  *) printf 'claudii-otel: unknown command: %s\n' "$cmd" >&2; exit 1 ;;
esac
