#!/bin/bash
# claudii-otel — fold Claude Code's local OTLP/JSON export into the perf cache.
#
# The OTEL path is optional and local-only. bin/claudii-otel-receiver flattens
# every log record and span Claude Code emits to one JSON line under
# $CACHE/otel/events/<kind>-<UTC day>.ndjson (kinds: llm err api tool hook
# other unparsed — the receiver's docstring has the record shape), and
# `claudii-otel build` folds the llm + err kinds into the SAME .latency shape
# lib/cmd/perf.sh already renders from transcripts — plus the exact fields the
# transcript estimate can't provide (duration_ms, ttft_ms, api_error status
# codes). The only claudii<->OTEL coupling is the local file; nothing here
# touches the network.
#
# Optional fan-out (perf.otel.forward): the receiver tees each batch verbatim to
# an internal collector gateway. claudii itself never reads the gateway — it
# only reads the local files; the forward is purely for central retention.
#
# Usage:
#   claudii-otel build [--days N]   # emit {source,latency,errors} JSON on stdout
#                  [--render rows|json --render-floor DAY [--repo NAME]]
#                                   # …or what `claudii perf` shows, in one pass
#   claudii-otel compact            # gzip closed days and build their rows/
#   claudii-otel receiver [args]    # exec the local OTLP receiver (foreground)
#   claudii-otel doctor             # check receiver wiring + data freshness
#   claudii-otel cache-dir          # print the OTEL data directory

set -uo pipefail
export CLAUDII_HOME="${CLAUDII_HOME:-$(cd "$(dirname "$0")/.." && pwd)}"
command -v jq >/dev/null 2>&1 || { printf 'claudii-otel: jq not found — install jq\n' >&2; exit 1; }

CACHE_BASE="${CLAUDII_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/claudii}"
OTEL_DIR="$CACHE_BASE/otel"
INSIGHTS_DIR="$CACHE_BASE/insights"
REPOMAP_LOG="$CACHE_BASE/insights-repomap.tsv"   # written by claudii-insights aggregate
EVENTS_DIR="$OTEL_DIR/events"
ROWS_DIR="$OTEL_DIR/rows"
STATUS_FILE="$OTEL_DIR/receiver.status"
ROWS_PROGRAM="$CLAUDII_HOME/lib/otel_rows.jq"
RECEIVER="$CLAUDII_HOME/bin/claudii-otel-receiver"

_mtime() { stat -f%m "$1" 2>/dev/null || stat -c%Y "$1" 2>/dev/null || echo 0; }

# shellcheck source=lib/insights_stream.sh
source "$CLAUDII_HOME/lib/insights_stream.sh"

# floor = today - (days-1) in UTC; BSD date first, GNU fallback (matches perf).
# window-cutoff probe — keep in sync with _window_cutoffs (lib/timefmt.sh)
_floor_day() {
  local days="$1"
  date -u -v-"$(( days - 1 ))"d +%Y-%m-%d 2>/dev/null \
    || date -u -d "$(( days - 1 )) days ago" +%Y-%m-%d 2>/dev/null \
    || printf ''
}

# {sessionId: repo} for OTEL samples — events carry session.id but no cwd.
# Source: the sessionId<TAB>repo log claudii-insights aggregate maintains
# (later lines win; one small file instead of parsing every insights cache —
# 3 s for 15k caches). Without the log (before the first full aggregate run),
# the caches themselves are read, bounded by the window: an event in the
# window belongs to a session whose last_seen is in the window too
# (lib/insights_stream.sh). The log is a superset of that and resolves the
# same sessions. Emits exactly one JSON object: `{}` replaces a failed run
# instead of being appended to whatever jq had already printed.
_repomap() {
  local days="${1:-}" map
  if [[ -f "$REPOMAP_LOG" ]]; then
    map=$(jq -cRn 'reduce (inputs | split("\t")) as $f ({};
             if ($f | length) == 2 and $f[0] != "" and $f[1] != ""
             then .[$f[0]] = $f[1] else . end)' "$REPOMAP_LOG" 2>/dev/null) || map=""
  else
    map=$(_insights_stream "$INSIGHTS_DIR" "$days" \
      | jq -cn 'reduce inputs as $s ({};
             if ($s.sessionId // null) != null and ($s.project.repo // "") != ""
             then .[$s.sessionId] = $s.project.repo else . end)' 2>/dev/null) || map=""
  fi
  printf '%s' "${map:-"{}"}"
}

# Storage layout under $OTEL_DIR (the receiver writes events/ and the status
# file, everything else is derived here):
#   events/<kind>-YYYY-MM-DD[.<tag>].ndjson     open (today's) or not yet gzipped
#   events/<kind>-YYYY-MM-DD[.<tag>].ndjson.gz  closed days — the lossless history
#   rows/YYYY-MM-DD.v<N>.ndjson                 perf samples of a closed day,
#                                               from its llm/err .gz (otel_rows.jq)
#   receiver.status                             the running receiver's counters
# build reads rows + the plain llm/err files of its window only, so its cost
# follows the window, not the history.
#
# Two rules keep the history safe and every sample counted once:
#   - event data only ever moves INTO a .gz (plain → .gz → plain removed); no
#     code path deletes an event file whose content is not in a .gz already;
#   - rows are derived from the llm/err .gz files alone, so a plain file that is
#     still around (open day, quiet guard, failed gzip) is never also in rows.
#     Delete a rows file to have it rebuilt (e.g. after restoring .gz files).
#
# Bump when lib/otel_rows.jq's row shape or extraction changes: rows files of
# another version are ignored, and compact rebuilds them from the gzipped days.
OTEL_ROWS_VERSION=1
# A request that straddles UTC midnight can still append to yesterday's file;
# compact leaves an event file of yesterday alone until it has been quiet this long.
COMPACT_QUIET_SECS=600
# Two compacts never run concurrently; build skips compaction while the lock
# is held.
LOCK_DIR="$OTEL_DIR/.lock"

_DAY_RE='([0-9]{4}-[0-9]{2}-[0-9]{2})'
# Sets _DAY to the YYYY-MM-DD in a file name ("" if none) — no subshell, it
# runs once per file.
_file_day() {
  _DAY=""
  if [[ "${1##*/}" =~ $_DAY_RE ]]; then _DAY="${BASH_REMATCH[1]}"; fi
}

# 0 = acquired. A lock is stale when its holder is gone (killed perf, crash),
# when its pid now belongs to some other program (recycled after a reboot —
# checked with ps where available; without ps the lock counts as held), or
# when it has no pid file a minute after creation. No age limit: a compact
# that is merely suspended (laptop lid, Ctrl-Z) is alive and must keep it.
# A stale lock is renamed away before a new one is made; that mv is atomic,
# which narrows — but does not close — the window for two takeovers at once.
_otel_lock_holder_alive() {
  local pid="$1" cmd
  kill -0 "$pid" 2>/dev/null || return 1
  cmd=$(ps -p "$pid" -o command= 2>/dev/null) || return 0
  [[ -z "$cmd" || "$cmd" == *claudii-otel* ]]
}
_otel_lock() {
  mkdir -p "$OTEL_DIR" 2>/dev/null
  if mkdir "$LOCK_DIR" 2>/dev/null; then
    printf '%s\n' "$$" > "$LOCK_DIR/pid"; return 0
  fi
  local pid
  pid=$(cat "$LOCK_DIR/pid" 2>/dev/null)
  if [[ -n "$pid" ]]; then
    _otel_lock_holder_alive "$pid" && return 1
  elif [[ -d "$LOCK_DIR" ]] && (( $(date +%s) - $(_mtime "$LOCK_DIR") < 60 )); then
    return 1
  fi
  # Released between our mkdir and now: just take it.
  if [[ -d "$LOCK_DIR" ]]; then
    mv "$LOCK_DIR" "$LOCK_DIR.stale.$$" 2>/dev/null || return 1
    rm -rf "$LOCK_DIR.stale.$$"
  fi
  mkdir "$LOCK_DIR" 2>/dev/null || return 1
  printf '%s\n' "$$" > "$LOCK_DIR/pid"
}
_otel_unlock() { rm -rf "$LOCK_DIR"; }

_cmd_compact() {
  _otel_lock || { printf 'compact: another compact is running\n' >&2; return 1; }
  _compact_locked; local rc=$?
  _otel_unlock
  return "$rc"
}

# Gzip every closed day's plain event files, then build its rows from the
# llm/err gz files if the rows file is missing. One rule keeps rows current:
# whatever is about to change a day's llm/err gz set deletes that day's rows
# FIRST — so a crash at any later point leaves rows missing (rebuilt next
# pass), never stale. Other kinds (tool, hook, …) are gzipped without touching
# rows. No mtime comparison: under bash 3.2 it has whole-second resolution, and
# a gz written in the same second as its rows looked "not newer". Caller holds
# the lock.
_compact_locked() {
  [[ -d "$EVENTS_DIR" ]] || return 0
  mkdir -p "$ROWS_DIR" || return 1
  local today yesterday now
  today=$(date -u +%Y-%m-%d)
  yesterday=$(_floor_day 2)
  now=$(date +%s)
  local f nf day days=" " rows tmp old busy rc=0
  local -a plain gz
  shopt -s nullglob
  # Leftovers of an interrupted run — the lock rules out a live one.
  rm -f "$ROWS_DIR"/*.ndjson.?????? "$EVENTS_DIR"/*.gz.tmp
  for f in "$EVENTS_DIR"/*.ndjson "$EVENTS_DIR"/*.ndjson.gz; do
    _file_day "$f"; day="$_DAY"
    [[ -n "$day" && "$day" < "$today" ]] || continue
    [[ "$days" == *" $day "* ]] || days+="$day "
  done
  for day in $days; do
    plain=("$EVENTS_DIR"/*-"$day"*.ndjson)
    busy=0
    if [[ "$day" == "$yesterday" ]]; then
      for f in ${plain[@]+"${plain[@]}"}; do
        [[ "${f##*/}" == *-"$day".ndjson ]] || continue   # only the receiver's own files
        (( now - $(_mtime "$f") < COMPACT_QUIET_SECS )) && busy=1
      done
    fi
    (( busy )) && continue
    rows="$ROWS_DIR/$day.v$OTEL_ROWS_VERSION.ndjson"
    for f in ${plain[@]+"${plain[@]}"}; do
      case "${f##*/}" in llm-*|err-*) rm -f "$rows"; break ;; esac
    done
    for f in ${plain[@]+"${plain[@]}"}; do
      if [[ -e "$f.gz" ]]; then
        # An interrupted run: the gzip landed, the rm did not.
        if gzip -dc "$f.gz" 2>/dev/null | cmp -s - "$f"; then rm -f "$f"; continue; fi
        # Different data under a taken name: keep both, the new one renamed
        # to a name that is free as plain AND as .gz (never overwrite data).
        local n=0
        nf="${f%.ndjson}.$now.ndjson"
        while [[ -e "$nf" || -e "$nf.gz" ]]; do
          nf="${f%.ndjson}.$now-$(( ++n )).ndjson"
        done
        mv "$f" "$nf" || { rc=1; continue; }
        f="$nf"
      fi
      if gzip -c "$f" > "$f.gz.tmp" && mv -f "$f.gz.tmp" "$f.gz"; then
        rm -f "$f"
      else
        rm -f "$f.gz.tmp"; rc=1
      fi
    done
    gz=("$EVENTS_DIR"/llm-"$day"*.ndjson.gz "$EVENTS_DIR"/err-"$day"*.ndjson.gz)
    (( ${#gz[@]} )) || continue
    [[ -f "$rows" ]] && continue
    tmp=$(mktemp "$rows.XXXXXX") || { rc=1; continue; }
    # A .gz that does not decode fails the whole day: no rows from a prefix.
    if ( for f in "${gz[@]}"; do gzip -dc "$f" || exit 1; done ) \
         | jq -cnR -f "$ROWS_PROGRAM" > "$tmp"; then
      mv -f "$tmp" "$rows"
      for old in "$ROWS_DIR/$day".v*.ndjson; do
        [[ "$old" == "$rows" ]] || rm -f "$old"
      done
    else
      rm -f "$tmp"; rc=1
    fi
  done
  shopt -u nullglob
  return "$rc"
}

# build [--days N] [--render rows|json --render-floor DAY [--repo NAME]]
# Without --render: the {source,latency,errors} document. With --render: what
# `claudii perf` shows, computed in the same jq pass (lib/perf_rows.jq or
# lib/perf_json.jq over lib/otel_doc.jq) — no 40-60 MB intermediate document
# to write and parse again. --render-floor is perf's calendar floor, which can
# differ from build's UTC day floor. A render prints NOTHING when the window
# holds no latency sample, so perf falls back to the transcript estimate.
_cmd_build() {
  local days=30 render="" rfloor="" repo=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --days)         shift; days="${1:-30}" ;;
      --render)       shift; render="${1:-}" ;;
      --render-floor) shift; rfloor="${1:-}" ;;
      --repo)         shift; repo="${1:-}" ;;
      *) printf 'build: unknown option: %s\n' "$1" >&2; exit 1 ;;
    esac
    shift
  done
  if ! [[ "$days" =~ ^[0-9]+$ ]] || [[ "$days" -lt 1 ]]; then
    printf 'build: --days must be a positive integer (got: %s)\n' "$days" >&2; exit 1
  fi
  case "$render" in
    ""|rows|json) ;;
    *) printf 'build: --render must be rows or json (got: %s)\n' "$render" >&2; exit 1 ;;
  esac
  [[ -n "$render" && -z "$rfloor" ]] && { printf 'build: --render needs --render-floor\n' >&2; exit 1; }

  # Compaction is an optimisation for later runs: while another compact holds
  # the lock it is skipped, and build reads whatever is there.
  if _otel_lock; then _compact_locked; _otel_unlock; fi

  # Files are picked by the day in their name. A rows/event file is named after
  # the day a batch ARRIVED; a span that started before midnight arrives after
  # it, so files from one day before the floor are read too and the per-row
  # .day filter in lib/otel_doc.jq does the exact cut.
  local floor from
  floor=$(_floor_day "$days")
  from=$(_floor_day "$(( days + 1 ))")
  local rows=() fresh=() f
  shopt -s nullglob
  for f in "$ROWS_DIR"/*.v"$OTEL_ROWS_VERSION".ndjson; do
    _file_day "$f"; [[ -n "$_DAY" && ! "$_DAY" < "$from" ]] && rows+=("$f")
  done
  for f in "$EVENTS_DIR"/llm-*.ndjson "$EVENTS_DIR"/err-*.ndjson; do
    _file_day "$f"; [[ -n "$_DAY" && ! "$_DAY" < "$from" ]] && fresh+=("$f")
  done
  shopt -u nullglob
  if (( ${#rows[@]} + ${#fresh[@]} == 0 )); then
    [[ -z "$render" ]] && printf '{"source":"otel","latency":[],"errors":[]}\n'
    return 0
  fi

  # The repo map goes to jq as a FILE, never as one --argjson argument: with
  # ~15k sessions it is ~0.8 MB — over Linux's 128 KiB per-argument cap already
  # and close to macOS's 1 MiB total.
  local mapfile; mapfile=$(mktemp "${TMPDIR:-/tmp}/claudii-otel-map.XXXXXX") || return 1
  _repomap "$days" > "$mapfile"
  # Plain event lines go through otel_rows.jq with -R, so one half-written
  # line (live-appended NDJSON) skips itself via fromjson? instead of aborting.
  # Output is compact (-c): at 90 days pretty-printing made it 46% larger, and
  # every consumer parses it again.
  {
    if (( ${#rows[@]} )); then
      printf '%s\0' "${rows[@]}" | { xargs -0 cat 2>/dev/null || true; }
    fi
    if (( ${#fresh[@]} )); then
      printf '%s\0' "${fresh[@]}" \
        | { xargs -0 cat 2>/dev/null || true; } \
        | jq -cnR -f "$ROWS_PROGRAM"
    fi
  } | case "$render" in
        rows) jq -rn -L "$CLAUDII_HOME/lib" --slurpfile repomap "$mapfile" --arg floor "$floor" \
                --arg rfloor "$rfloor" --arg repo "$repo" '
                include "otel_doc"; include "perf_rows";
                otel_doc($repomap[0]; $floor)
                | if (.latency | length) == 0 then empty else perf_rows($rfloor; $repo) end' ;;
        json) jq -n -L "$CLAUDII_HOME/lib" --slurpfile repomap "$mapfile" --arg floor "$floor" \
                --arg rfloor "$rfloor" --arg repo "$repo" --argjson days "$days" '
                include "otel_doc"; include "perf_json";
                otel_doc($repomap[0]; $floor)
                | if (.latency | length) == 0 then empty
                  else perf_json($days; $rfloor; $repo; "otel") end' ;;
        *)    jq -cn -L "$CLAUDII_HOME/lib" --slurpfile repomap "$mapfile" --arg floor "$floor" '
                include "otel_doc"; otel_doc($repomap[0]; $floor)' ;;
      esac
  local rc=$?
  rm -f "$mapfile"
  return "$rc"
}

_cmd_receiver() {
  [[ -f "$RECEIVER" ]] || { printf 'claudii-otel: receiver not found: %s\n' "$RECEIVER" >&2; exit 1; }
  command -v python3 >/dev/null 2>&1 || { printf 'claudii-otel: python3 required for the receiver\n' >&2; exit 1; }
  exec python3 "$RECEIVER" "$@"
}

_sha256() { shasum -a 256 "$1" 2>/dev/null | cut -d' ' -f1 || sha256sum "$1" 2>/dev/null | cut -d' ' -f1; }

# The exact pipeline that turns a pre-events capture into event files — printed
# by doctor, never run by it (the data is the user's). The receiver must run
# THIS code first: an old one keeps writing the old layout, which nothing reads.
_convert_hint() {
  printf '               1. restart the receiver:  launchctl kickstart -k gui/%s/com.claudii.otel-receiver\n' "$(id -u)"
  printf '               2. %s | %q --flatten %q --tag %s\n' "$1" "$RECEIVER" "$EVENTS_DIR" "$2"
  printf '               3. move the old files away (the conversion refuses to run twice for one tag)\n'
}

_cmd_doctor() {
  printf 'claudii-otel doctor\n'
  if command -v python3 >/dev/null 2>&1; then
    printf '  python3      %s\n' "$(command -v python3)"
  else
    printf '  python3      MISSING — the receiver needs it\n'
  fi
  printf '  otel dir     %s\n' "$OTEL_DIR"
  local now; now=$(date +%s)
  # The running receiver reports through receiver.status (sha of the file it
  # loaded, last batch, forward counters); doctor compares that sha with the
  # repo's receiver so a stale copy or wrapper target is visible.
  if [[ -s "$STATUS_FILE" ]] && jq -e . "$STATUS_FILE" >/dev/null 2>&1; then
    local s_sha s_pid s_last s_batches s_records s_wfail f_on f_ok f_failed f_dropped f_err f_err_at r_sha
    # Empty fields become "-": with IFS=tab an empty field collapses and every
    # later field shifts (the empty-field trap).
    IFS=$'\t' read -r s_sha s_pid s_last s_batches s_records s_wfail f_on f_ok f_failed f_dropped f_err_at f_err < <(
      jq -r '[.sha, .pid, .last_batch, .batches, .records, .write_failed, .forward.enabled, .forward.ok,
              .forward.failed, .forward.dropped, .forward.last_error_at, .forward.last_error]
             | map(if . == null or . == "" then "-" else . end) | @tsv' "$STATUS_FILE")
    r_sha=$(_sha256 "$RECEIVER")
    if [[ "$s_pid" != "-" ]] && ! kill -0 "$s_pid" 2>/dev/null; then
      printf '  receiver     NOT RUNNING — receiver.status is from pid %s, which is gone' "$s_pid"
    elif [[ -n "$r_sha" && "$s_sha" == "$r_sha" ]]; then
      printf '  receiver     sha matches bin/claudii-otel-receiver'
    else
      printf '  receiver     DRIFT: running sha %s != repo %s — restart or rewrap the receiver' "${s_sha:0:12}" "${r_sha:0:12}"
    fi
    if [[ "${s_last:-0}" -gt 0 ]]; then
      printf ' · last batch %ds ago · %s batches, %s records\n' "$(( now - s_last ))" "$s_batches" "$s_records"
    else
      printf ' · no batch since start\n'
    fi
    [[ "${s_wfail:-0}" != "0" ]] && printf '  WRITE FAIL   %s failed write(s) — check disk space (receiver.status: last_write_error)\n' "$s_wfail"
    if [[ "$f_on" == "true" ]]; then
      printf '  forward      ok %s · failed %s · dropped %s' "$f_ok" "$f_failed" "$f_dropped"
      [[ "$f_err" != "-" ]] && printf ' · last error %ds ago: %s' "$(( now - f_err_at ))" "$f_err"
      printf '\n'
    fi
  else
    printf '  receiver     no receiver.status — receiver not running, or older than this claudii\n'
  fi
  local today f mt newest=0 n=0 kinds="" k
  today=$(date -u +%Y-%m-%d)
  shopt -s nullglob
  local plain=("$EVENTS_DIR"/*.ndjson) gz=("$EVENTS_DIR"/*.ndjson.gz)
  local rows=("$ROWS_DIR"/*.v"$OTEL_ROWS_VERSION".ndjson)
  shopt -u nullglob
  for f in ${plain[@]+"${plain[@]}"}; do
    mt=$(_mtime "$f"); (( mt > newest )) && newest=$mt
  done
  for k in llm err api tool hook other unparsed; do
    f="$EVENTS_DIR/$k-$today.ndjson"
    [[ -s "$f" ]] || continue
    kinds+="$k $(wc -l < "$f" | tr -d ' ') · "
  done
  if (( newest > 0 )); then
    printf '  events       today: %s%d open file(s) · last write %ds ago\n' "$kinds" "${#plain[@]}" "$(( now - newest ))"
  else
    printf '  events       (no open event file — receiver not running, or no session yet)\n'
  fi
  if (( ${#gz[@]} )); then
    printf '  history      %d gzipped file(s) · %s on disk\n' "${#gz[@]}" "$(du -sh "$OTEL_DIR" 2>/dev/null | cut -f1 | tr -d ' ')"
  fi
  if (( ${#rows[@]} )); then
    n=$(printf '%s\0' "${rows[@]}" | { xargs -0 cat 2>/dev/null || true; } | grep -c '"kind":"lat"')
  fi
  printf '  samples      %s response(s) in %d compacted day(s)\n' "$n" "${#rows[@]}"
  local fwd; fwd=$("$CLAUDII_HOME/bin/claudii" config get perf.otel.forward 2>/dev/null)
  # Captures of earlier layouts are not read any more; print the conversion.
  if [[ -s "$OTEL_DIR/traces.jsonl" || -s "$OTEL_DIR/logs.jsonl" ]]; then
    printf '  legacy       traces.jsonl/logs.jsonl (single-file layout, not read) — convert once, then move them away:\n'
    _convert_hint "cat $(printf '%q' "$OTEL_DIR")/{traces,logs}.jsonl" legacy
  fi
  if [[ -d "$OTEL_DIR/raw" ]]; then
    printf '  legacy       raw/ (day-file layout, not read) — convert once, then move it away:\n'
    _convert_hint "{ for f in $(printf '%q' "$OTEL_DIR")/raw/*.jsonl.gz; do gzip -dc \"\$f\"; done; cat $(printf '%q' "$OTEL_DIR")/raw/*.jsonl 2>/dev/null; }" conv
  fi
  if [[ -r "$CACHE_BASE/otel.env" ]]; then
    printf '  env wiring   %s (telemetry exported to the receiver)\n' "$CACHE_BASE/otel.env"
  else
    printf '  env wiring   off — run: claudii-otel setup\n'
  fi
  if [[ -n "$fwd" ]]; then
    printf '  forward cfg  %s (batches mirrored to the gateway)\n' "$fwd"
  else
    printf '  forward cfg  off (local-only; set perf.otel.forward to fan out)\n'
  fi
}

# Enable the OTEL path: flip the config flag, write the shell env file the plugin
# sources (fork-free), and generate a launchd plist for a persistent receiver.
# The plist is written to the cache (not auto-installed) — the user loads it, so
# nothing touches ~/Library/LaunchAgents without consent.
_cmd_setup() {
  local cli="$CLAUDII_HOME/bin/claudii"
  local endpoint beta forward
  endpoint=$("$cli" config get perf.otel.endpoint 2>/dev/null); [[ -z "$endpoint" ]] && endpoint="http://127.0.0.1:4318"
  beta=$("$cli" config get perf.otel.beta_traces 2>/dev/null)
  forward=$("$cli" config get perf.otel.forward 2>/dev/null)
  "$cli" config set perf.otel.enabled true >/dev/null 2>&1

  mkdir -p "$OTEL_DIR"
  local envf="$CACHE_BASE/otel.env"
  {
    printf '%s\n' '# generated by `claudii-otel setup` — sourced by the claudii plugin.'
    printf '%s\n' '# Points Claude Code telemetry at the local receiver. Undo: claudii-otel off.'
    printf '%s\n' 'export CLAUDE_CODE_ENABLE_TELEMETRY=1'
    printf '%s\n' 'export OTEL_LOGS_EXPORTER=otlp'
    printf '%s\n' 'export OTEL_TRACES_EXPORTER=otlp'
    printf '%s\n' 'export OTEL_METRICS_EXPORTER=none'
    printf '%s\n' 'export OTEL_EXPORTER_OTLP_PROTOCOL=http/json'
    printf 'export OTEL_EXPORTER_OTLP_ENDPOINT=%s\n' "$endpoint"
    [[ "$beta" == "true" ]] && printf '%s\n' 'export CLAUDE_CODE_ENHANCED_TELEMETRY_BETA=1'
    [[ -n "$forward" ]] && printf 'export CLAUDII_OTEL_FORWARD=%s\n' "$forward"
  } > "$envf"

  local py; py=$(command -v python3 || echo /usr/bin/python3)
  local py_dir; py_dir=$(dirname "$py")
  # Invoke the receiver script directly (arg0), not `python3 <script>`, so macOS
  # Login Items / "Allow in the Background" shows it as "claudii-otel-receiver"
  # instead of "python3". The env-shebang then needs Homebrew on PATH (launchd's
  # default PATH lacks it) — set in EnvironmentVariables below. Keep it +x.
  chmod +x "$RECEIVER" 2>/dev/null || true
  local plist="$OTEL_DIR/com.claudii.otel-receiver.plist"
  # The receiver process needs CLAUDII_OTEL_FORWARD too (it does the teeing), so
  # bake it into the plist env when configured.
  local fwd_xml=""
  [[ -n "$forward" ]] && printf -v fwd_xml '\n    <key>CLAUDII_OTEL_FORWARD</key><string>%s</string>' "$forward"
  cat > "$plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.claudii.otel-receiver</string>
  <key>ProgramArguments</key>
  <array>
    <string>$RECEIVER</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>$py_dir:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>CLAUDII_OTEL_DIR</key><string>$OTEL_DIR</string>$fwd_xml
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardErrorPath</key><string>$OTEL_DIR/receiver.log</string>
  <key>StandardOutPath</key><string>$OTEL_DIR/receiver.log</string>
</dict>
</plist>
PLIST

  printf 'claudii-otel: OTEL source enabled (perf.otel.enabled=true)\n'
  printf '  env written:   %s\n' "$envf"
  printf '  plist written: %s\n' "$plist"
  [[ -n "$forward" ]] && printf '  forwarding to: %s\n' "$forward"
  printf '\n'
  printf 'Next steps:\n'
  printf '  1. Start the receiver (persistent, restarts on boot):\n'
  printf '       cp "%s" ~/Library/LaunchAgents/\n' "$plist"
  printf '       launchctl load ~/Library/LaunchAgents/com.claudii.otel-receiver.plist\n'
  printf '  2. Reload your shell so the telemetry env is exported:  exec zsh\n'
  printf '  3. Run a Claude session, then:  claudii perf\n'
  printf '\nNo launchd? Run the receiver yourself:  claudii-otel receiver\n'
}

# Disable the OTEL path: flip the flag back and remove the shell env file. perf
# reverts to the transcript estimate. The launchd job is left for the user to
# unload (we never loaded it).
_cmd_off() {
  local cli="$CLAUDII_HOME/bin/claudii"
  "$cli" config set perf.otel.enabled false >/dev/null 2>&1
  rm -f "$CACHE_BASE/otel.env"
  printf 'claudii-otel: OTEL source disabled (perf reverts to the transcript estimate)\n'
  printf '  removed: %s\n' "$CACHE_BASE/otel.env"
  printf 'Stop the receiver:\n'
  printf '  launchctl unload ~/Library/LaunchAgents/com.claudii.otel-receiver.plist\n'
}

cmd="${1:-build}"; shift || true
case "$cmd" in
  build)     _cmd_build "$@" ;;
  compact)   _cmd_compact ;;
  receiver)  _cmd_receiver "$@" ;;
  setup)     _cmd_setup "$@" ;;
  off)       _cmd_off "$@" ;;
  doctor)    _cmd_doctor "$@" ;;
  cache-dir) printf '%s\n' "$OTEL_DIR" ;;
  -h|--help|help)
    cat <<'EOF'
claudii-otel — fold local OTLP/JSON telemetry into the perf cache

Usage:
  claudii-otel setup              enable the OTEL source (config + env + plist)
  claudii-otel off                disable it (perf reverts to transcript)
  claudii-otel build [--days N]   emit {source,latency,errors} JSON on stdout
      [--render rows|json --render-floor DAY [--repo NAME]]
                                  …or what `claudii perf` shows, in one pass
  claudii-otel compact            gzip closed days' event files and build their
                                  rows/ (build does this on its own)
  claudii-otel receiver [args]    exec the local OTLP receiver (foreground);
                                  `receiver --flatten DIR [--tag TAG]` converts
                                  OTLP batch lines on stdin into event files
  claudii-otel doctor             check receiver wiring + data freshness
  claudii-otel cache-dir          print the OTEL data directory

Fan-out (optional): set perf.otel.forward to an internal collector URL and the
receiver mirrors every batch there (best-effort) for central retention.
EOF
    ;;
  *) printf 'claudii-otel: unknown command: %s\n' "$cmd" >&2; exit 1 ;;
esac
