#!/bin/bash
# claudii — Claude Interaction Intelligence CLI
# Usage: claudii <command> [args]
#
# Thin dispatcher — command logic lives in lib/cmd/*.sh, helpers in lib/helpers.sh

set -euo pipefail

# 1 when the calling shell already exported CLAUDII_HOME (claudii.plugin.zsh
# does) — doctor's "plugin loaded" check; the export below hides it otherwise.
_CLAUDII_HOME_INHERITED="${CLAUDII_HOME:+1}"
# Resolve the checkout through symlinks: install.sh links this file into
# /usr/local/bin, where `dirname "$0"` named /usr/local and every source below
# failed. One readlink per hop — macOS readlink has no -f; 40 hops ends a loop.
if [[ -z "${CLAUDII_HOME:-}" ]]; then
  _cl_self="$0" _cl_hops=0
  while [[ -L "$_cl_self" ]] && (( _cl_hops++ < 40 )); do
    _cl_link=$(readlink "$_cl_self")
    [[ "$_cl_link" == /* ]] || _cl_link="$(dirname "$_cl_self")/$_cl_link"
    _cl_self="$_cl_link"
  done
  CLAUDII_HOME="$(cd "$(dirname "$_cl_self")/.." && pwd)"
  unset _cl_self _cl_hops _cl_link
fi
export CLAUDII_HOME
source "$CLAUDII_HOME/lib/visual.sh"
source "$CLAUDII_HOME/lib/spinner.sh"
source "$CLAUDII_HOME/lib/helpers.sh"
source "$CLAUDII_HOME/lib/search_dir.sh"
source "$CLAUDII_HOME/lib/render.sh"
VERSION="0.30.0"

# TTY detection — 1 if stdout is a terminal, 0 if piped
_TTY=0
[ -t 1 ] && _TTY=1

# Explicit output format flag (--json / --tsv), parsed before alias expansion
_FORMAT=""
_args_filtered=()
for _arg in "$@"; do
  case "$_arg" in
    --json) _FORMAT="json" ;;
    --tsv)  _FORMAT="tsv"  ;;
    *)      _args_filtered+=("$_arg") ;;
  esac
done
set -- "${_args_filtered[@]+"${_args_filtered[@]}"}"
unset _args_filtered _arg

command -v jq >/dev/null 2>&1 || {
  echo "claudii: jq not found. Install: brew install jq" >&2; exit 1
}

# Auto colors (git-style): blank all ANSI constants when stdout is not a
# terminal, so piped/redirected pretty output is clean text. --json/--tsv are
# already plain by construction. CLAUDII_FORCE_COLOR=1 opts back in (pagers
# like `claudii se | less -R`). The theme loader respects the blanking via
# its empty-RESET guard (lib/visual.sh).
if (( ! _TTY )) && [[ "${CLAUDII_FORCE_COLOR:-0}" != "1" ]]; then
  CLAUDII_CLR_GREEN="" CLAUDII_CLR_YELLOW="" CLAUDII_CLR_RED="" CLAUDII_CLR_CYAN=""
  CLAUDII_CLR_DIM="" CLAUDII_CLR_BOLD="" CLAUDII_CLR_ACCENT="" CLAUDII_CLR_RESET=""
  CLAUDII_FP_PALETTE=("" "" "" "" "" "")
fi

usage() {
  local d="${CLAUDII_CLR_DIM}›${CLAUDII_CLR_RESET}"  # dim separator
  printf '\n'
  printf "  ${CLAUDII_CLR_CYAN}claudii${CLAUDII_CLR_RESET} ${CLAUDII_CLR_ACCENT}v%s${CLAUDII_CLR_RESET} — Claude Interaction Intelligence\n" "$VERSION"
  printf '\n'
  printf "  ${CLAUDII_CLR_ACCENT}aliases${CLAUDII_CLR_RESET}\n"
  local _def="${CLAUDII_HOME}/config/defaults.json"
  while IFS=$'\t' read -r _a _m _e _desc; do
    [[ -z "$_a" ]] && continue
    printf "    %-5s  %-7s  %-6s  $d %s\n" "$_a" "$_m" "$_e" "$_desc"
  done < <(jq -r '.aliases // {} | to_entries[] | [.key, .value.model, .value.effort, .value.description] | @tsv' "$_def" 2>/dev/null)
  printf "    %-5s  %-21s  $d %s\n"      "clh" ""                 "alias table + model status"
  printf '\n'
  printf "  ${CLAUDII_CLR_ACCENT}Display Layers${CLAUDII_CLR_RESET}\n"
  printf "    %-33s $d %s\n" "on | off"                        "enable/disable all layers"
  printf "    %-33s $d %s\n" "claudestatus [on|off]"           "ClaudeStatus RPROMPT toggle"
  printf "    %-33s $d %s\n" "session-dashboard [on|off]"      "Session Dashboard above-prompt toggle"
  printf "    %-33s $d %s\n" "cc-statusline [on|off|preset]"   "CC-Statusline inside Claude (on/off, preset focused|calm|default)"
  printf "    %-33s $d %s\n" "insomnii [on|off|auto|install]"  "bedtime statusline plugin (delegates clock segment)"
  printf '\n'
  printf "  ${CLAUDII_CLR_ACCENT}Sessions${CLAUDII_CLR_RESET}\n"
  printf "    %-33s $d %s\n" "sessions (se)"                   "list all active sessions"
  printf "    %-33s $d %s\n" "sessions-inactive (si)"          "list all inactive sessions"
  printf "    %-33s $d %s\n" "session <session-id>"            "per-session token / tool drilldown"
  printf "    %-33s $d %s\n" "pin / unpin <session-id>"        "protect session from GC"
  printf "    %-33s $d %s\n" "gc (g)"                          "clean up stale session caches"
  printf "    %-33s $d %s\n" "resume <session-id>"             "resume a session by ID"
  printf '\n'
  printf "  ${CLAUDII_CLR_ACCENT}Cost${CLAUDII_CLR_RESET}\n"
  printf "    %-33s $d %s\n" "cost (c)"                        "aggregate session costs"
  printf "    %-33s $d %s\n" "week (w)"                        "usage inside the weekly rate-limit window"
  printf "    %-33s $d %s\n" "trends (t)"                      "weekly/daily cost history"
  printf "    %-33s $d %s\n" "skills-cost"                     "per-skill / per-plugin / per-MCP-tool cost breakdown"
  printf '\n'
  printf "  ${CLAUDII_CLR_ACCENT}Activity & Insights${CLAUDII_CLR_RESET}\n"
  printf "    %-33s $d %s\n" "vibemap [grid|strip|status]"     "activity heatmap (opt-in)"
  printf "    %-33s $d %s\n" "tokens [--days N]"               "token usage by type / model / day"
  printf "    %-33s $d %s\n" "perf (pf) [--repo NAME]"         "response-time p50/p90/p99, tok/s, latency trend, health"
  printf "    %-33s $d %s\n" "tools [--days N]"                "tool call counts, error rates, subagents"
  printf "    %-33s $d %s\n" "repos [REPO] [--daily]"          "sessions per repo — count + real duration"
  printf "    %-33s $d %s\n" "limits [--days N]"               "rate-limit hits — when + which model"
  printf "    %-33s $d %s\n" "cache [--days N]"                "prompt-cache hit-rate insights"
  printf '\n'
  printf "  ${CLAUDII_CLR_ACCENT}Config & Integrations${CLAUDII_CLR_RESET}\n"
  printf "    %-33s $d %s\n" "config [get|set|reset|export|import]" "manage configuration"
  printf "    %-33s $d %s\n" "agents"                          "configured agents (alias→skill)"
  printf "    %-33s $d %s\n" "search ['query']"                "launch Claude in search mode"
  printf "    %-33s $d %s\n" "sync [NAME|status|add|rm]"       "merge sessions from other hosts and accounts (ssh)"
  printf '\n'
  printf "  ${CLAUDII_CLR_ACCENT}System${CLAUDII_CLR_RESET}\n"
  printf "    %-33s $d %s\n" "status (s) [5m|15m|30m|60m]"     "live model check · refresh interval"
  printf "    %-33s $d %s\n" "doctor (d)"                      "installation health check"
  printf "    %-33s $d %s\n" "explain"                         "components, symbols & data flow"
  printf "    %-33s $d %s\n" "update"                          "update to latest version"
  printf "    %-33s $d %s\n" "version"                         "show version number"
  printf "    %-33s $d %s\n" "changelog"                       "release notes for current version"
  printf "    %-33s $d %s\n" "restart"                         "reload plugin"
  printf '\n'
  printf '\n'
  printf "  ${CLAUDII_CLR_ACCENT}man claudii${CLAUDII_CLR_RESET}  full reference\n"
  printf '\n'
}

_cmd_resume() {
  local _id="${1:-}"
  case "$_id" in
    # Caught before the exec: `claudii resume --bogus` used to hand the flag
    # straight to `claude --resume --bogus` and answer 0.
    -*) _cli_unknown_opt resume "$_id" '<session-id>' || return $? ;;
  esac
  if [[ -z "$_id" ]]; then
    echo "Usage: claudii resume <session-id>" >&2
    echo "  Use 'claudii se' to list sessions with their IDs" >&2
    return 1
  fi
  exec claude --resume "$_id"
}

source "$CLAUDII_HOME/lib/cmd/system.sh"
source "$CLAUDII_HOME/lib/cmd/sessions.sh"
source "$CLAUDII_HOME/lib/cmd/cost.sh"
source "$CLAUDII_HOME/lib/cmd/overview.sh"
source "$CLAUDII_HOME/lib/cmd/skills-cost.sh"
source "$CLAUDII_HOME/lib/cmd/display.sh"
source "$CLAUDII_HOME/lib/cmd/config.sh"
source "$CLAUDII_HOME/lib/vibemap.sh"
source "$CLAUDII_HOME/lib/cmd/vibemap.sh"
source "$CLAUDII_HOME/lib/cmd/insights.sh"
source "$CLAUDII_HOME/lib/cmd/perf.sh"
source "$CLAUDII_HOME/lib/cmd/week.sh"
source "$CLAUDII_HOME/lib/cmd/sync.sh"

# Centralized config+theme boot — every command needs CLAUDII_CLR_* painted
# with the user's theme.name before it prints a single line. Handlers that
# never touch config (gc, pin, unpin, vibemap, cc-statusline, update,
# changelog) used to render in the default palette, because only _cfg_init
# loaded the theme. Loading it once here, before the case below, covers every
# handler, including the next one added.
#
# `version` is deliberately excluded: it never emits a color, and scripts and
# completions shell out to it repeatedly, so the theme-load jq fork would buy
# nothing. Handlers that also call _cfg_init themselves (se, cost, doctor, …)
# resolve the theme twice — accepted.
#
# Deliberately NOT the full `_cfg_init`: that also mkdir -p's the config dir
# and copies config/defaults.json into place on a first run, which only a
# handler about to WRITE config needs. Those handlers still call `_cfg_init`
# themselves.
_claudii_boot() {
  case "${1:-}" in
    version) return 0 ;;
  esac
  CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/claudii"
  CONFIG="$CONFIG_DIR/config.json"
  DEFAULTS="$CLAUDII_HOME/config/defaults.json"
  _claudii_theme_load
}

# Shorthand aliases — expand before main dispatcher.
case "${1:-}" in
  s)     set -- status             "${@:2}" ;;
  pf)    set -- perf               "${@:2}" ;;
  se)    set -- sessions           "${@:2}" ;;
  ss)    set -- sessions           "${@:2}" ;;
  si)    set -- sessions-inactive  "${@:2}" ;;
  about) set -- changelog          "${@:2}" ;;
  c)     set -- cost               "${@:2}" ;;
  w)     set -- week               "${@:2}" ;;
  t)     set -- trends             "${@:2}" ;;
  d)     set -- doctor             "${@:2}" ;;
  g)     set -- gc                 "${@:2}" ;;
esac

_claudii_boot "${1:-}"

# Commands that take no arguments at all — their dispatch arm below calls the
# handler with none, so an extra token could never be seen and was silently
# swallowed: `claudii doctor --bogus` just ran the doctor and answered 0, and
# `claudii update --bogus` went ahead and updated. One gate here rather than a
# guard bolted onto each of the fifteen handlers (several of which live in files
# this dispatcher only sources).
#
# --json/--tsv are already stripped into $_FORMAT above, so `doctor --json`
# still arrives here as a bare `doctor`.
#
# Nothing derives this list, so it can rot — tests/test_arg_contract.sh walks
# EVERY arm of the dispatch case below and fails on the first one that does not
# answer rc 2, which is what keeps it honest.
case "${1:-}" in
  on|off|update|doctor|sessions-inactive|trends|explain|version|changelog|42|agents|restart|help|--help|-h)
    if [[ $# -gt 1 ]]; then _cli_unknown_opt "$1" "$2" || exit $?; fi
    ;;
esac

# Calling convention: a handler receives its OWN arguments — "${@:2}" — never
# the command name. Three conventions used to be in play here ("$@", "${@:2}",
# and nothing at all), which is why every command carried its own way of
# skipping the command name, and why `claudii cost --bogus` was unrejectable:
# its parser looped over the full "$@" including the literal "cost", so it had
# to tolerate every token it did not recognise.
#
# The arms still passing "$@" (status, config, session-dashboard, …) hand it
# to handlers that index $2 themselves. Except for perf, which skips $1 itself
# and already meets the contract, they are on tests/test_arg_contract.sh's
# list of commands not yet under it.
case "${1:-}" in
  # System commands
  on)                  _cmd_on                ;;
  off)                 _cmd_off               ;;
  claudestatus)        _cmd_claudestatus "$@"        ;;
  session-dashboard)   _cmd_session_dashboard "$@"   ;;
  status)              _cmd_status "$@"       ;;
  cc-statusline)       _cmd_cc_statusline "$@" ;;
  insomnii)            _cmd_insomnii "$@"      ;;
  update)              _cmd_update            ;;
  doctor)              _cmd_doctor            ;;

  # Session commands
  cost)                _cmd_cost "${@:2}"     ;;
  week)                _cmd_week "${@:2}"     ;;
  skills-cost)         _cmd_skills_cost "${@:2}" ;;
  sessions)
    if [[ "${2:-}" == "--resume" && -n "${3:-}" ]]; then
      exec claude --resume "$3"
    fi
    _cmd_sessions "$@"
    ;;
  sessions-inactive)   _cmd_sessions_inactive ;;
  pin)                 _cmd_pin "$@"          ;;
  unpin)               _cmd_unpin "$@"        ;;
  gc)                  _cmd_gc "$@"           ;;
  resume)              _cmd_resume "${@:2}"   ;;
  "")                  _cmd_default           ;;

  # Display commands
  trends)              _cmd_trends            ;;
  cache)               _cmd_cache "${@:2}"    ;;
  tokens)              _cmd_tokens "${@:2}"   ;;
  tools)               _cmd_tools "${@:2}"    ;;
  repos)               _cmd_repos "${@:2}"    ;;
  perf)                _cmd_perf "$@"         ;;  # "$@": _cmd_perf skips $1 itself
  limits)              _cmd_limits "${@:2}"   ;;
  session)             _cmd_session "${@:2}"  ;;
  explain)             _cmd_explain           ;;
  version)             _cmd_version           ;;
  changelog)           _cmd_changelog         ;;
  42)                  _cmd_42                ;;

  # Config commands
  config)              _cmd_config "$@"       ;;
  agents)              _cmd_agents            ;;
  search)              _cmd_search "$@"       ;;
  vibemap)             _cmd_vibemap "$@"      ;;
  sync)                _cmd_sync "${@:2}"     ;;

  restart)
    # Shell-only by nature: reloading means re-sourcing ~/.zshrc in the CALLING
    # shell, which a child process cannot do. The plugin's `claudii` wrapper
    # (lib/functions.zsh) intercepts this before the binary is reached, so
    # arriving here means the plugin is not loaded — say that instead of
    # "Unknown command", which is what a documented command used to answer.
    echo "claudii: 'restart' is a shell function — it re-sources your shell, which this binary cannot do." >&2
    echo "  Load the plugin (source .../claudii.plugin.zsh) or run: exec zsh" >&2
    exit 1
    ;;

  # Help
  help|--help|-h)      usage                  ;;

  # Unknown
  *)
    echo "Unknown command: $1 — run 'claudii help' for available commands" >&2
    usage; exit 1
    ;;
esac
